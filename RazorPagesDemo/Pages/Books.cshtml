@page
@model RazorPagesDemo.Pages.BooksModel
@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Style</th>
            <th>Publisher</th>
            <th>Year of Publication</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
        <tr>
            <td><a asp-page="/BookDetail" asp-route-id="@book.Id">@book.Title</a></td>
            <td>@book.Author</td>
            <td>@book.Style</td>
            <td>@book.Publisher</td>
            <td>@book.YearOfPublication</td>
        </tr>
        }
    </tbody>
</table>

<a asp-page="/AddBook">Add New Book</a>

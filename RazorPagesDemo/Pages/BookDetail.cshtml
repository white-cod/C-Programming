@page "/BookDetail/{id}"
@model RazorPagesDemo.Pages.BookDetailModel

<h1>Book Details</h1>

@if (Model.Book != null)
{
<div>
    <h2>@Model.Book.Title</h2>
    <p><strong>Author:</strong> @Model.Book.Author</p>
    <p><strong>Style:</strong> @Model.Book.Style</p>
    <p><strong>Publisher:</strong> @Model.Book.Publisher</p>
    <p><strong>Year of Publication:</strong> @Model.Book.YearOfPublication</p>
</div>

<a asp-page="/EditBook" asp-route-id="@Model.Book.Id">Edit</a>

<form method="post" asp-page-handler="Delete" asp-route-id="@Model.Book.Id">
    <button type="submit" onclick="return confirm('Are you sure you want to delete this book?')">Delete</button>
</form>
}
else
{
<p>Book not found!</p>
}